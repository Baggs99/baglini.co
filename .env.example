# West African Produce storefront: copy to .env (gitignored) and fill in Stripe TEST keys for the MVP.
# Vercel and Render need the same variables set in their dashboards.

# Stripe test mode. Use sk_test_... and the test-mode webhook signing secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Supabase project (run west-african-produce/supabase/schema.sql first)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Password for the staff queue at /west-african-produce/admin
ADMIN_PASSWORD=replace_me

# Optional: public origin for Stripe return URLs. Defaults to the request host.
APP_URL=http://localhost:3000
