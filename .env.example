# West African Produce storefront. Copy to .env (gitignored).
# Stripe TEST keys. Live keys must never be committed.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend test receipts after Stripe marks an order paid.
RESEND_API_KEY=re_replace_me
RESEND_FROM="West African Produce <dan@baglini.co>"
WAP_STAFF_EMAIL=dan@baglini.co

# Staff queue at /west-african-produce/admin
ADMIN_PASSWORD=replace_me

# Public origin for Stripe return URLs. Defaults to the request host.
APP_URL=http://localhost:5173

# Optional product database. If omitted, Stripe stores purchase orders.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_me
